{
	"name": "digital-dekanat",
	"version": "0.1.0",
	"private": true,
	"description": "Прототип «Цифрового деканата будущего» для МГИМО: спокойное ядро, тёплый интерфейс",
	"type": "module",
	"packageManager": "yarn@4.5.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --max-warnings 25",
		"lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix --max-warnings 25",
		"format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{json,md,js,mjs}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"fix:staged": "lint-staged",
		"check": "yarn lint && yarn format:check && yarn type-check && yarn test",
		"ci-critical": "yarn lint && yarn format:check && yarn type-check",
		"prepare": "husky"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.106.0",
		"canvas-confetti": "^1.9.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^0.469.0",
		"motion": "^12.42.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.5",
		"tailwind-merge": "^3.7.0",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@tailwindcss/vite": "^4.3.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^22.10.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jsdom": "^27.4.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.7.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^7.3.7",
		"vitest": "^4.1.12"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix --max-warnings 10"
		],
		"tests/**/*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix --max-warnings 10"
		],
		"*.{json,md,css,yml,yaml,html,mjs,js,cjs}": [
			"prettier --write"
		]
	}
}
